[Unit]
Description=WSLg shared memory for Hyprland zero-copy frames
ConditionVirtualization=wsl
ConditionPathIsMountPoint=/mnt/wslg
DefaultDependencies=no
After=local-fs.target
Before=multi-user.target

[Mount]
What=wslg
Where=/mnt/wslgshm
Type=virtiofs
Options=dax,nosuid,nodev,noexec
DirectoryMode=0777

[Install]
WantedBy=multi-user.target
