configuration {
    modes: [ drun, run, window ];
    font: "sans 10";
    show-icons: true;
    terminal: "foot";
    drun-display-format: "{name}";
    hide-scrollbar: true;
    display-drun: "  Apps";
    display-run: "  Run";
    display-window: "  Window";
}

* {
    bg: #1e1e2e;
    fg: #cdd6f4;
    accent: #89b4fa;
    selected: #313244;
    border-col: #89b4fa;
    background-color: @bg;
    text-color: @fg;
}

window {
    width: 560px;
    height: 380px;
    border: 2px;
    border-color: @border-col;
    border-radius: 8px;
    padding: 12px;
}

inputbar {
    children: [ prompt, entry ];
    padding: 6px;
    spacing: 10px;
}

prompt {
    background-color: @accent;
    text-color: @bg;
    padding: 5px 12px;
    border-radius: 4px;
}

entry {
    placeholder: "Search applications...";
    placeholder-color: #6c7086;
    padding: 5px;
}

listview {
    columns: 2;
    lines: 7;
    spacing: 5px;
    padding: 10px 0 0 0;
}

element {
    padding: 6px 10px;
    border-radius: 5px;
    spacing: 8px;
}

element selected {
    background-color: @selected;
    text-color: @accent;
}

element-icon {
    size: 20px;
}
